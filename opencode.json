    "planner": {
      "description": "Read-only implementation planner for a GitHub issue",
      "mode": "primary",
      "model": "opencode/deepseek-v4.1-flash",
      "temperature": 0.1,
      "steps": 25,
      "prompt": "{file:./.opencode/prompts/planner.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "lsp": "allow",
        "doom_loop": "allow",
        "skill": "allow",
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch*": "allow",
          "git ls-files*": "allow",
          "gh issue view*": "allow",
          "gh pr view*": "allow",
          "gh pr diff*": "allow",
          "gh pr checks*": "allow"
        },
        "webfetch": "deny",
        "external_directory": "deny",
        "question": "deny",
        "task": "deny"
      }
    },
